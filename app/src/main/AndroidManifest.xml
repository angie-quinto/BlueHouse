<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.example.bluehousev3">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />


    <uses-feature
        android:name="android.hardware.camera"
        android:required="true" />

    <application
        android:name=".views.AppContext"
        android:allowBackup="true"
        android:icon="@drawable/ic_logof"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_logof"
        android:supportsRtl="true"
        android:theme="@style/Theme.BlueHouseV3"
        tools:ignore="ExtraText">



        <activity
            android:name=".views.ForgotPassword"
            android:exported="false" />
        <activity
            android:name=".views.SplashScreenActivity"
            android:exported="true"
            android:theme="@style/SplashTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".views.Register2"
            android:exported="false" />
        <activity
            android:name=".worker.WorkerHomePage"
            android:exported="true"
            android:windowSoftInputMode="adjustPan" />
        <activity
            android:name=".client.ClientHomePageActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustPan" />
        <activity
            android:name=".views.RegisterIds"
            android:exported="true" />
        <activity
            android:name=".views.Services"
            android:exported="true" />
        <activity
            android:name=".views.Register"
            android:exported="true" />
        <activity
            android:name=".views.LogIn"
            android:exported="true" />
        <activity
            android:name=".views.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
            </intent-filter>
        </activity>

        <service
            android:name=".views.MainActivity"
            android:foregroundServiceType="location" />

        <meta-data
            android:name="preloaded_fonts"
            android:resource="@array/preloaded_fonts" />
    </application>

</manifest>
<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".client.available_workers.transactions.WorkerProfile">


    <TextView
        android:id="@+id/tv_workerProfile_workerName"
        android:layout_width="@dimen/width_textView"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Worker Name:"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.504"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_workerProfile_profilePic" />

    <ImageView
        android:id="@+id/iv_workerProfile_profilePic"
        android:layout_width="185dp"
        android:layout_height="116dp"
        android:layout_marginTop="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:src="@tools:sample/avatars" />

    <Button
        android:id="@+id/btn_reviews"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="524dp"
        android:text="reviews"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.707"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btn_ids"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="460dp"
        android:text="Ids"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.801"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_workerProfile_workerAge"
        android:layout_width="@dimen/width_textView"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="Age: "
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_workerProfile_workerName" />

    <TextView
        android:id="@+id/tv_workerProfile_email"
        android:layout_width="@dimen/width_textView"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="Email: "
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_workerProfile_workerAge" />

    <TextView
        android:id="@+id/tv_workerProfile_mobile"
        android:layout_width="@dimen/width_textView"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="Mobile Number: "
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.501"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_workerProfile_email" />

    <TextView
        android:id="@+id/tv_workerProfile_rating"
        android:layout_width="@dimen/width_textView"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="Rating: "
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_workerProfile_mobile" />

    <Button
        android:id="@+id/btn_certs"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="532dp"
        android:text="Certificates"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.205"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btn_requestService"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="460dp"
        android:text="Request A Service"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.151"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_workerProfile_numberOfServicesCompleted"
        android:layout_width="@dimen/width_textView"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="Number of Services Completed: "
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_workerProfile_rating" />

    <TextView
        android:id="@+id/tv_workerProfile_educationalAtt"
        android:layout_width="@dimen/width_textView"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="Educational Attainment: "
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_workerProfile_numberOfServicesCompleted" />

    <TextView
        android:id="@+id/tv_workerProfile_hourlyRate"
        android:layout_width="@dimen/width_textView"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="Hourly Rate: "
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_workerProfile_educationalAtt" />

    <TextView
        android:id="@+id/tv_workerProfile_gender"
        android:layout_width="@dimen/width_textView"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="Gender: "
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_workerProfile_hourlyRate" />

    <TextView
        android:id="@+id/tv_workerProfile_address"
        android:layout_width="@dimen/width_textView"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="Address: "
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_workerProfile_gender" />

</androidx.constraintlayout.widget.ConstraintLayout>
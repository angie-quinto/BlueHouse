<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".views.RegisterIds">

    <ImageView
        android:id="@+id/ib_validId1"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="5dp"
        android:background="@drawable/blue_outline"
        app:layout_constraintEnd_toEndOf="@+id/spVid2"
        app:layout_constraintStart_toStartOf="@+id/spVid2"
        app:layout_constraintTop_toBottomOf="@+id/spVid2"
        app:srcCompat="@drawable/ic_valid" />

    <TextView
        android:id="@+id/textView3"
        android:layout_width="261dp"
        android:layout_height="48dp"
        android:layout_marginTop="5dp"
        android:gravity="center"
        android:text="In order to become a verified user you need to provide the following:"
        android:textColor="#000000"
        android:textStyle="normal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.492"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_getVerified"
        android:layout_width="@dimen/width_textView"
        android:layout_height="@dimen/btn_height2"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="44dp"
        android:background="@drawable/button_outline"
        android:text="Submit"
        android:textAllCaps="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.494"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ib_validId_2"
        app:layout_constraintVertical_bias="0.078" />

    <TextView
        android:id="@+id/textView7"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Take a Selfie"
        android:textColor="#000000"
        app:layout_constraintEnd_toEndOf="@+id/textView3"
        app:layout_constraintHorizontal_bias="0.502"
        app:layout_constraintStart_toStartOf="@+id/textView3"
        app:layout_constraintTop_toBottomOf="@+id/textView3" />

    <TextView
        android:id="@+id/textView10"
        android:layout_width="163dp"
        android:layout_height="36dp"
        android:layout_marginTop="5dp"
        android:gravity="center"
        android:text="certificates - for workers only (optional)"
        android:textColor="#000000"
        app:layout_constraintEnd_toEndOf="@+id/ib_selfie"
        app:layout_constraintStart_toStartOf="@+id/ib_selfie"
        app:layout_constraintTop_toBottomOf="@+id/ib_selfie" />

    <ProgressBar
        android:id="@+id/progressBar3"
        style="?android:attr/progressBarStyle"
        android:layout_width="108dp"
        android:layout_height="97dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.376" />

    <Spinner
        android:id="@+id/sp_valid1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:minHeight="48dp"
        app:layout_constraintEnd_toEndOf="@+id/ib_validId1"
        app:layout_constraintStart_toStartOf="@+id/ib_validId1"
        app:layout_constraintTop_toBottomOf="@+id/ib_validId1"
        tools:ignore="SpeakableTextPresentCheck" />

    <Spinner
        android:id="@+id/spVid2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:minHeight="48dp"
        app:layout_constraintEnd_toEndOf="@+id/ib_cert"
        app:layout_constraintStart_toStartOf="@+id/ib_cert"
        app:layout_constraintTop_toBottomOf="@+id/ib_cert"
        tools:ignore="SpeakableTextPresentCheck" />

    <ImageView
        android:id="@+id/ib_selfie"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="5dp"
        android:background="@drawable/blue_outline"
        app:layout_constraintEnd_toEndOf="@+id/textView7"
        app:layout_constraintStart_toStartOf="@+id/textView7"
        app:layout_constraintTop_toBottomOf="@+id/textView7"
        app:srcCompat="@drawable/ic_selfie_b" />

    <ImageView
        android:id="@+id/ib_cert"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="5dp"
        android:background="@drawable/blue_outline"
        app:layout_constraintEnd_toEndOf="@+id/textView10"
        app:layout_constraintHorizontal_bias="0.507"
        app:layout_constraintStart_toStartOf="@+id/textView10"
        app:layout_constraintTop_toBottomOf="@+id/textView10"
        app:srcCompat="@drawable/ic_certificate" />

    <ImageView
        android:id="@+id/ib_validId_2"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="5dp"
        android:background="@drawable/blue_outline"
        app:layout_constraintEnd_toEndOf="@+id/sp_valid1"
        app:layout_constraintStart_toStartOf="@+id/sp_valid1"
        app:layout_constraintTop_toBottomOf="@+id/sp_valid1"
        app:srcCompat="@drawable/ic_valid" />

</androidx.constraintlayout.widget.ConstraintLayout>
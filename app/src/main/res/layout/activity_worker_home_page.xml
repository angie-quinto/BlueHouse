<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".worker.WorkerHomePage">

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/worker_bottom_nav"
        android:layout_width="413dp"
        android:layout_height="49dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/worker_nav_menu" />


    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragment_container_worker"
        android:name="com.example.bluehousev3.worker.PendingRequests"
        android:layout_width="412dp"
        android:layout_height="676dp"
        android:layout_marginTop="52dp"
        android:layout_marginBottom="5dp"
        app:layout_constraintBottom_toTopOf="@+id/worker_bottom_nav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.901" />
</androidx.constraintlayout.widget.ConstraintLayout>